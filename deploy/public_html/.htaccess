# AvaStudio — frontend SPA (React) + API Laravel dalam satu document root.
#
# Aturan penting: JANGAN menyerahkan directory root ke DirectoryIndex, karena
# cPanel mendahulukan index.php (Laravel) sebelum index.html (SPA). Semua
# request non-/api dan non-file harus berakhir di index.html.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Teruskan header Authorization (Bearer token Sanctum)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Semua request /api/* ditangani Laravel
    RewriteRule ^api(/.*)?$ index.php [L]

    # Root selalu SPA
    RewriteRule ^$ index.html [L]

    # File statis yang benar-benar ada (assets, favicon, /storage/...) disajikan langsung
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Sisanya -> SPA fallback (React Router)
    RewriteRule ^ index.html [L]
</IfModule>

# Root docroot wajib index.html (SPA), bukan index.php (Laravel)
DirectoryIndex index.html index.php

# Jangan tampilkan daftar isi folder
Options -Indexes
